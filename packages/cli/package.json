{
    "name": "@promptsonar/cli",
    "version": "1.6.0",
    "description": "Static security scanner for MCP configs, agent instructions and prompts. Local, zero LLM calls. CLI.",
    "bin": {
        "promptsonar": "dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meghal86/promptsonar.git",
        "directory": "packages/cli"
    },
    "homepage": "https://github.com/meghal86/promptsonar#readme",
    "scripts": {
        "build": "tsup src/cli.ts src/index.ts --format cjs --dts --clean",
        "prepublishOnly": "rimraf dist && npm run build",
        "dev": "ts-node src/cli.ts",
        "test": "vitest run"
    },
    "keywords": [
        "cli",
        "mcp",
        "model-context-protocol",
        "mcp-security",
        "ai-security",
        "llm-security",
        "prompt-injection",
        "prompt-security",
        "agent-security",
        "owasp",
        "owasp-llm-top-10",
        "sarif",
        "static-analysis",
        "security",
        "scanner",
        "llm",
        "claude",
        "cursor"
    ],
    "author": "Meghal Parikh",
    "license": "MIT",
    "dependencies": {
        "@promptsonar/core": "^1.6.0",
        "chalk": "^4.1.2",
        "commander": "^12.0.0",
        "fast-glob": "^3.3.2",
        "ignore": "^5.3.2",
        "ora": "^5.4.1",
        "yaml": "^2.3.1"
    },
    "devDependencies": {
        "ts-node": "^10.9.2",
        "tsup": "^8.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
