{
    "name": "@promptsonar/cli",
    "version": "1.2.0",
    "description": "Static security scanner for LLM prompts — CLI tool",
    "bin": {
        "promptsonar": "dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/meghal86/promptsonar.git",
        "directory": "packages/cli"
    },
    "homepage": "https://github.com/meghal86/promptsonar#readme",
    "scripts": {
        "build": "tsup src/cli.ts src/index.ts --format cjs --dts --clean",
        "dev": "ts-node src/cli.ts"
    },
    "keywords": [
        "cli",
        "llm",
        "security",
        "prompt-security",
        "scanner"
    ],
    "author": "Meghal Parikh",
    "license": "MIT",
    "dependencies": {
        "@promptsonar/core": "^1.2.0",
        "commander": "^12.0.0",
        "fast-glob": "^3.3.2",
        "chalk": "^4.1.2",
        "ora": "^5.4.1",
        "yaml": "^2.3.1"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.9.3",
        "ts-node": "^10.9.2"
    }
}
