{
  "name": "@promptsonar/core",
  "version": "1.6.0",
  "description": "Engine for the PromptSonar static security scanner: MCP configs, agent instructions and prompts. Deterministic, zero LLM calls.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "queries"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meghal86/promptsonar.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/meghal86/promptsonar#readme",
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "rimraf dist tsconfig.tsbuildinfo && npm run build",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-security",
    "ai-security",
    "llm-security",
    "prompt-injection",
    "prompt-security",
    "agent-security",
    "owasp",
    "owasp-llm-top-10",
    "sarif",
    "static-analysis",
    "security",
    "scanner",
    "llm",
    "claude",
    "cursor",
    "ai-safety"
  ],
  "author": "Meghal Parikh",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "minimatch": "^10.2.5",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/minimatch": "^5.1.2",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
