{
    "name": "promptsonar",
    "displayName": "PromptSonar",
    "description": "Static scanner for prompt injection (OWASP LLM01), API key leaks & jailbreaks in code. Local, fast, no LLM calls.",
    "version": "1.5.0",
    "icon": "icon.png",
    "keywords": [
        "prompt",
        "security",
        "injection",
        "llm",
        "owasp",
        "scanner",
        "linter",
        "ai"
    ],
    "publisher": "promptsonar-tools",
    "repository": {
        "type": "git",
        "url": "https://github.com/meghal86/promptsonar.git"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Linters",
        "Machine Learning"
    ],
    "main": "./dist/client/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "promptsonar.compress",
                "title": "PromptSonar: Compress with LLMLingua"
            },
            {
                "command": "promptsonar.runScan",
                "title": "PromptSonar: Run Health Check",
                "icon": "$(play)"
            },
            {
                "command": "promptsonar.scanWorkspace",
                "title": "PromptSonar: Scan Entire Workspace",
                "icon": "$(shield)"
            },
            {
                "command": "promptsonar.scanCurrentFile",
                "title": "PromptSonar: Scan Current File"
            },
            {
                "command": "promptsonar.openExecutionPath",
                "title": "PromptSonar: Open Execution Path"
            },
            {
                "command": "promptsonar.analyzeRepositoryExecutionMap",
                "title": "PromptSonar: Analyze Repository Execution Map",
                "icon": "$(graph)"
            },
            {
                "command": "promptsonar.exportSarif",
                "title": "PromptSonar: Export SARIF"
            },
            {
                "command": "promptsonar.copyReport",
                "title": "PromptSonar: Copy Report"
            },
            {
                "command": "promptsonar.copyExecutionPath",
                "title": "PromptSonar: Copy Execution Path"
            },
            {
                "command": "promptsonar.showWorkflowDiff",
                "title": "PromptSonar: Show Workflow Diff"
            },
            {
                "command": "promptsonar.applyFixAndShowWorkflowDiff",
                "title": "PromptSonar: Apply Fix + Show Workflow Diff"
            },
            {
                "command": "promptsonar.openPlayground",
                "title": "PromptSonar: Open Playground"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "promptsonar.runScan",
                    "group": "navigation"
                }
            ],
            "view/title": [
                {
                    "command": "promptsonar.scanWorkspace",
                    "when": "view == promptsonar-explorer",
                    "group": "navigation"
                },
                {
                    "command": "promptsonar.analyzeRepositoryExecutionMap",
                    "when": "view == promptsonar-explorer",
                    "group": "navigation"
                },
                {
                    "command": "promptsonar.scanCurrentFile",
                    "when": "view == promptsonar-execution-path",
                    "group": "navigation"
                }
            ],
            "editor/context": [
                {
                    "command": "promptsonar.scanCurrentFile",
                    "group": "promptsonar@1",
                    "when": "editorTextFocus"
                },
                {
                    "command": "promptsonar.showWorkflowDiff",
                    "group": "promptsonar@2",
                    "when": "editorTextFocus"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "promptsonar-sidebar",
                    "title": "PromptSonar",
                    "icon": "icon.png"
                }
            ]
        },
        "views": {
            "promptsonar-sidebar": [
                {
                    "id": "promptsonar-explorer",
                    "name": "Prompt Analysis",
                    "icon": "icon.png"
                },
                {
                    "id": "promptsonar-execution-path",
                    "name": "Execution Path",
                    "icon": "icon.png"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "PromptSonar",
            "properties": {
                "promptsonar.enable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable PromptSonar"
                },
                "promptsonar.enableCodeLens": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable/disable 'Run Health Check' CodeLenses above detected prompts"
                },
                "promptsonar.debounceMs": {
                    "type": "number",
                    "default": 300,
                    "description": "Delay before re-scanning while typing (live diagnostics and panel)."
                },
                "promptsonar.maxFileSizeBytes": {
                    "type": "number",
                    "default": 1048576,
                    "description": "Maximum file size (bytes) PromptSonar will scan live. Larger files are skipped to keep the editor responsive."
                },
                "promptsonar.maxWorkspaceScanFiles": {
                    "type": "number",
                    "default": 2000,
                    "description": "Maximum number of files PromptSonar will scan in a workspace scan after ignore rules are applied."
                },
                "promptsonar.useClosureScan": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use opt-in closure analysis for the existing repository execution map command."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "build": "node esbuild.js --production",
        "compile": "node esbuild.js --production",
        "watch": "node esbuild.js --watch",
        "package": "vsce package --no-dependencies",
        "publish:marketplace": "vsce publish --no-dependencies --packagePath promptsonar-1.4.3.vsix",
        "lint": "eslint src --ext ts",
        "test": "vitest run",
        "pretest": "npm run compile"
    },
    "dependencies": {
        "@promptsonar/core": "^1.5.0",
        "ignore": "^5.3.2",
        "vscode-languageclient": "^9.0.1",
        "vscode-languageserver": "^9.0.1",
        "vscode-languageserver-textdocument": "^1.0.11",
        "vscode-uri": "^3.0.8"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.80.0",
        "@vitest/coverage-v8": "^4.0.18",
        "esbuild": "^0.27.3",
        "typescript": "^5.0.0",
        "vitest": "^4.0.18"
    }
}
